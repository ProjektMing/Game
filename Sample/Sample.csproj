<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Stg.Nez\Stg.Nez.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\fnalibs\x86\*.*" Condition="'$(Platform)' == 'x86'" Visible="false">
            <Link>%(Platform)\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\fnalibs\x64\*.*" Condition="'$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'" Visible="false">
            <Link>%(Platform)\%(Filename)%(Extension)</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Update="ContentPathGenerator.tt">
            <Generator>TextTemplatingFileGenerator</Generator>
            <LastGenOutput>ContentPathGenerator.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="ContentPathGenerator.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>ContentPathGenerator.tt</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Content/**/*.*" Exclude="**/*.fx; **/.keep Content/Content-Goes-Here.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

</Project>
